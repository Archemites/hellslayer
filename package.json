{
  "name": "hellslayer",
  "version": "0.1.0",
  "description": "PARAINFERNÁLIA — Beta 1",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.hellslayer.game",
    "productName": "PARAINFERNÁLIA",
    "executableName": "HELLSLAYER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "electron/**/*",
      "js/**/*",
      "vendor/**/*",
      "fonts/**/*",
      "soundeffect/**/*",
      "soundtrack/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "private": true,
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
